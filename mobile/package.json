{
  "name": "@musike/mobile",
  "private": true,
  "version": "1.0.2",
  "description": "Beatmaker Cues for Android and iOS, with the backend running on the phone (Capacitor).",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @musike/web build:native && cap sync android",
    "build:ios": "pnpm --filter @musike/web build:native && cap sync ios",
    "xcode": "pnpm run build:ios && cap open ios",
    "xcode:export": "pnpm run build:ios && node scripts/export-xcode.mjs",
    "apk": "pnpm run build && node scripts/build-apk.mjs",
    "ipa": "node scripts/build-ipa.mjs",
    "open": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "typescript": "^7.0.2"
  }
}
