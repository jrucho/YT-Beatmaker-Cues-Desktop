{
  "name": "yt-beatmaker-cues-desktop",
  "private": true,
  "version": "1.0.1",
  "description": "A desktop music and beatmaking studio powered by Musike and YT Beatmaker Cues.",
  "license": "MIT",
  "repository": "github:jrucho/YT-Beatmaker-Cues-Desktop",
  "homepage": "https://github.com/jrucho/YT-Beatmaker-Cues-Desktop",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter ./server --filter ./web dev",
    "build": "pnpm --filter ./web build",
    "start": "pnpm --filter ./server start",
    "desktop": "pnpm --filter musike-desktop start",
    "installer": "pnpm --filter musike-desktop dist",
    "installer:win": "pnpm --filter musike-desktop dist",
    "installer:mac": "pnpm --filter musike-desktop dist:mac",
    "installer:linux": "pnpm --filter musike-desktop dist:linux",
    "typecheck": "pnpm -r typecheck",
    "test:app": "node scripts/check-app.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
